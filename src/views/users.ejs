<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/users.css" />

<body data-csrf="<%= csrfToken %>">
  <%- include('includes/nav', { member: member }) %>
  <div class="users-container">
    <% if(!member) { %>
    <div class="users-frame" style="color: #dddddd">
      <div class="board" style="font-size: 40px">Please login first!</div>
    </div>

    <% } else { %>
    <div class="users-frame">
      <div class="board">
        <div class="user-table">
          <span class="header-name" style="margin-bottom: 30px"
            >All Users List</span
          >
          <form
            action="/admin/user/all"
            method="GET"
            class="long-input"
            style="flex-direction: row; align-items: center; gap: 10px; margin-bottom: 20px"
          >
            <input
              type="text"
              name="search"
              placeholder="Search by nickname"
              value="<%= search %>"
              class="form-control"
              style="max-width: 300px"
            />
            <button type="submit" class="btn btn-primary">Search</button>
          </form>
          <table class="table table-hover table-sm">
            <thead class="thead-light">
              <tr class="thead-light">
                <th scope="col">No</th>
                <th scope="col">Name</th>
                <th scope="col">Image</th>
                <th scope="col">Phone</th>
                <th scope="col">Status</th>
              </tr>
            </thead>
            <!--  LOOP PRODUCTS: START  -->
            <% users.map(function(value, index){ %>
              <tbody style="background: white">
                <td><%= index +1 %></td>
                <td><%= value.memberNick %></td>
                <td>
                  <% if (value.memberImage) { %>
                    <img src="/<%= value.memberImage %>" alt="Member Image" style="width: 60px; height: auto; border-radius: 8px;" />
                  <% } else { %>
                    Not Available
                  <% } %>
                </td>
                               
                <td><%= value.memberPhone %></td>
                <td style="width: 13%">
                  <select class="spec-select member-status" id="<%= value._id %>">
                    <option value="ACTIVE" <%= value.memberStatus === 'ACTIVE' ? 'selected': '' %> >ACTIVE</option>
                    <option value="BLOCK" <%= value.memberStatus === 'BLOCK' ? 'selected': '' %> >BLOCK</option>
                    <option value="DELETE" <%= value.memberStatus === 'DELETE' ? 'selected': '' %> >DELETE</option>
                  </select>
                </td>
              </tbody>
            <% }) %> 
            <!--  LOOP PRODUCTS: END  -->
          </table>
          <nav
            class="long-input"
            style="flex-direction: row; justify-content: center; gap: 8px; margin-bottom: 25px"
          >
            <% if (page > 1) { %>
              <a
                class="btn btn-secondary"
                href="/admin/user/all?page=<%= page - 1 %>&search=<%= search %>"
              >Prev</a>
            <% } %>
            <% for (let i = 1; i <= totalPages; i++) { %>
              <a
                class="btn <%= i === page ? 'btn-primary' : 'btn-outline-primary' %>"
                href="/admin/user/all?page=<%= i %>&search=<%= search %>"
              ><%= i %></a>
            <% } %>
            <% if (page < totalPages) { %>
              <a
                class="btn btn-secondary"
                href="/admin/user/all?page=<%= page + 1 %>&search=<%= search %>"
              >Next</a>
            <% } %>
          </nav>
        </div>
      </div>
    </div>
    <% } %>
  </div>

  <script type="text/javascript" src="/js/users.js"></script>
</body>

<%- include('includes/footer') %>
